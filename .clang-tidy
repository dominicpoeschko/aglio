# clang-tidy configuration of aglio (clang-tidy 23). `just tidy` and CI run it over the clang test tree with
# run-clang-tidy; any finding in src/ or tests/ fails. A check that is wrong for this code is switched off here,
# never suppressed site by site; a remaining exception is
# `// NOLINTNEXTLINE(<check>) // <why this line is the exception>`.
# clang-diagnostic-* stays off: the tests build with -Weverything -Werror, the warnings are the compiler's.
Checks:
  - '-*'
  - bugprone-*
  - -bugprone-casting-through-void
  - -bugprone-crtp-constructor-accessibility
  - -bugprone-dynamic-static-initializers
  - -bugprone-easily-swappable-parameters
  - -bugprone-random-generator-seed
  - -bugprone-signed-char-misuse
  - -bugprone-signed-bitwise
  - -bugprone-throwing-static-initialization
  - -bugprone-unhandled-exception-at-new
  - clang-analyzer-*
  - -clang-analyzer-apiModeling.google.GTest
  - -clang-analyzer-fuchsia.*
  - -clang-analyzer-nullability.*
  - -clang-analyzer-optin.mpi.*
  - -clang-analyzer-optin.osx.*
  - -clang-analyzer-optin.performance.GCDAntipattern
  - -clang-analyzer-optin.performance.Padding
  - -clang-analyzer-optin.taint.*
  - -clang-analyzer-osx.*
  - -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
  - -clang-analyzer-webkit.*
  - concurrency-*
  - cppcoreguidelines-*
  - -cppcoreguidelines-avoid-c-arrays
  - -cppcoreguidelines-avoid-const-or-ref-data-members
  - -cppcoreguidelines-avoid-do-while
  - -cppcoreguidelines-avoid-magic-numbers
  - -cppcoreguidelines-avoid-non-const-global-variables
  - -cppcoreguidelines-c-copy-assignment-signature
  - -cppcoreguidelines-explicit-constructor
  - -cppcoreguidelines-explicit-virtual-functions
  - -cppcoreguidelines-macro-to-enum
  - -cppcoreguidelines-macro-usage
  - -cppcoreguidelines-missing-std-forward
  - -cppcoreguidelines-no-suspend-with-lock
  - -cppcoreguidelines-narrowing-conversions
  - -cppcoreguidelines-noexcept-destructor
  - -cppcoreguidelines-noexcept-move-operations
  - -cppcoreguidelines-noexcept-swap
  - -cppcoreguidelines-non-private-member-variables-in-classes
  - -cppcoreguidelines-pro-bounds-array-to-pointer-decay
  - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
  - -cppcoreguidelines-pro-bounds-constant-array-index
  - -cppcoreguidelines-pro-bounds-pointer-arithmetic
  - -cppcoreguidelines-pro-type-member-init
  - -cppcoreguidelines-pro-type-reinterpret-cast
  - -cppcoreguidelines-pro-type-vararg
  - -cppcoreguidelines-rvalue-reference-param-not-moved
  - -cppcoreguidelines-use-enum-class
  - -cppcoreguidelines-special-member-functions
  - -cppcoreguidelines-use-default-member-init
  - misc-*
  - -misc-const-correctness
  - -misc-coroutine-hostile-raii
  - -misc-definitions-in-headers
  - -misc-explicit-constructor
  - -misc-header-include-cycle
  - -misc-include-cleaner
  - -misc-multiple-inheritance
  - -misc-no-recursion
  - -misc-static-assert
  - -misc-use-internal-linkage
  - modernize-*
  - -modernize-avoid-c-arrays
  - -modernize-avoid-c-style-cast
  - -modernize-avoid-setjmp-longjmp
  - -modernize-concat-nested-namespaces
  - -modernize-macro-to-enum
  - -modernize-min-max-use-initializer-list
  - -modernize-use-auto
  - -modernize-use-designated-initializers
  - -modernize-use-integer-sign-comparison
  - -modernize-use-std-format
  - -modernize-use-std-print
  - -modernize-use-trailing-return-type
  - performance-*
  - -performance-enum-size
  - -performance-faster-string-find
  - -performance-no-int-to-ptr
  - portability-*
  - -portability-avoid-pragma-once
  - -portability-no-assembler
  - -portability-restrict-system-includes
  - -portability-simd-intrinsics
  - -portability-template-virtual-member-function
  - readability-*
  - -readability-avoid-nested-conditional-operator
  - -readability-avoid-return-with-void-value
  - -readability-convert-member-functions-to-static
  - -readability-function-cognitive-complexity
  - -readability-function-size
  - -readability-identifier-length
  - -readability-magic-numbers
  - -readability-make-member-function-const
  - -readability-math-missing-parentheses
  - -readability-named-parameter
  - -readability-qualified-auto
  - -readability-redundant-casting
  - -readability-redundant-lambda-parameter-list
  - -readability-redundant-member-init
  - -readability-redundant-nested-if
  - -readability-redundant-parentheses
  - -readability-redundant-qualified-alias
  - -readability-redundant-typename
  - -readability-static-accessed-through-instance
  - -readability-trailing-comma
  - -readability-use-anyofallof
  - google-build-explicit-make-pair
  - google-default-arguments
  - google-runtime-operator
HeaderFilterRegex: '.*/(src|tests)/.*'
ExcludeHeaderFilterRegex: '/_deps/'
SystemHeaders: false
FormatStyle: none
CheckOptions:
  bugprone-exception-escape.CheckMain: false
  bugprone-implicit-widening-of-multiplication-result.IgnoreConstantIntExpr: true
  bugprone-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion: true
  bugprone-narrowing-conversions.WarnOnEquivalentBitWidth: true
  bugprone-narrowing-conversions.WarnWithinTemplateInstantiation: true
  bugprone-narrowing-conversions.PedanticMode: false
  bugprone-sizeof-expression.WarnOnSizeOfCompareToConstant: false
  bugprone-unused-return-value.AllowCastToVoid: true
  bugprone-unused-return-value.CheckedReturnTypes: '^::std::error_code$;^::std::error_condition$;^::std::errc$;^::std::expected$'
  bugprone-empty-catch.IgnoreCatchWithKeywords: '@TODO;@FIXME;ignored:'
  concurrency-mt-unsafe.FunctionSet: posix
  misc-non-private-member-variables-in-classes.IgnorePublicMemberVariables: true
  misc-unused-parameters.IgnoreMacroParameters: true
  performance-move-const-arg.CheckTriviallyCopyableMove: false
  readability-implicit-bool-conversion.AllowIntegerConditions: true
  readability-implicit-bool-conversion.AllowPointerConditions: true
  readability-operators-representation.BinaryOperators: '&&;&=;&;|;~;!;!=;||;|=;^;^='
  readability-operators-representation.OverloadedOperators: '&&;&=;&;|;~;!;!=;||;|=;^;^='
  readability-simplify-boolean-expr.IgnoreMacros: true
  readability-simplify-boolean-expr.SimplifyDeMorgan: false
  readability-uppercase-literal-suffix.NewSuffixes: 'U;L;UL;LL;ULL;Z;UZ'
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.ClassIgnoredRegexp: '^(formatter|hash|tuple_size|tuple_element|numeric_limits|common_type|pointer_traits|iterator_traits|is_[a-z_]+|[a-z_]+_tag)$'
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.StructIgnoredRegexp: '^(formatter|hash|tuple_size|tuple_element|numeric_limits|common_type|pointer_traits|iterator_traits|is_[a-z_]+|[a-z_]+_tag|__.*)$'
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^[a-z][a-z0-9_]*$|_t$|^[A-Z][a-zA-Z0-9]*_$'
  readability-identifier-naming.TypedefCase: lower_case
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.TemplateParameterIgnoredRegexp: '^([A-Z][a-zA-Z0-9]*_)$'
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.FunctionIgnoredRegexp: '^(__.*|main|LLVMFuzzer[A-Za-z]+|format_to|Fields)$'
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.MethodIgnoredRegexp: '^([a-z][a-zA-Z0-9]*_|push_back|pop_back|emplace_back|push_front|pop_front|emplace_front|try_push_back|try_emplace_back|unchecked_push_back|unchecked_emplace_back|append_range|try_append_range|insert_range|assign_range|resize_and_overwrite|max_size|shrink_to_fit|remove_prefix|remove_suffix|starts_with|ends_with|find_first_of|find_last_of|has_value|value_or|try_lock|try_lock_for|try_lock_until|lock_shared|unlock_shared|format_to|parse|format|insert_or_assign|notify_one|notify_all|wait_for|wait_until|sleep_for|sleep_until|request_stop|get_stop_token)$'
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.ParameterIgnoredRegexp: '^([a-z][a-zA-Z0-9]*_)$'
  readability-identifier-naming.ConstantParameterCase: camelBack
  readability-identifier-naming.ConstantParameterIgnoredRegexp: '^([a-z][a-zA-Z0-9]*_)$'
  readability-identifier-naming.ConstantPointerParameterCase: camelBack
  readability-identifier-naming.ConstantPointerParameterIgnoredRegexp: '^([a-z][a-zA-Z0-9]*_)$'
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.VariableIgnoredRegexp: '^(__.*|[a-z][a-zA-Z0-9]*_)$'
  readability-identifier-naming.LocalConstantCase: camelBack
  readability-identifier-naming.LocalConstantIgnoredRegexp: '^([a-z][a-zA-Z0-9]*_)$'
  readability-identifier-naming.ConstexprVariableCase: camelBack
  readability-identifier-naming.ConstexprVariableIgnoredRegexp: '^([a-z][a-zA-Z0-9]*_|__.*|glaze_reflect|fmt_string|field_names|field_dims)$'
  readability-identifier-naming.ConstantCase: camelBack
  readability-identifier-naming.ConstantIgnoredRegexp: '^([a-z][a-zA-Z0-9]*_|__.*|fmt_string|field_names|field_dims)$'
  readability-identifier-naming.EnumConstantCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.MemberIgnoredRegexp: '^([a-z][a-zA-Z0-9]*_|escape_control_characters|indentation_width)$'
  readability-identifier-naming.ConstantMemberCase: camelBack
  readability-identifier-naming.ConstantMemberIgnoredRegexp: '^([a-z][a-zA-Z0-9]*_|escape_control_characters|indentation_width)$'
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.NamespaceIgnoredRegexp: '^([^d].*|d[^e].*|de[^t].*|det[^a].*|deta[^i].*|detai[^l].*|detail.+|d|de|det|deta|detai)$'
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.IgnoreMainLikeFunctions: true
