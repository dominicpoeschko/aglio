    inline std::filesystem::path relativize_if_not_absolute(const std::filesystem::path& working_directory,
                                                            const std::filesystem::path& filepath)
    {
       if (filepath.is_absolute()) {
          return filepath;
       }
 
       return working_directory / filepath;
    }
